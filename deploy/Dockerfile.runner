# Campaign runner image -- compose convenience today, and it IS the Horizon-3
# probe-worker image later. Build from repo root:
#   docker build -f deploy/Dockerfile.runner -t invigil-runner .
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends docker.io python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY site ./site
RUN pnpm install --frozen-lockfile && pnpm -r build
# configs, corpora and data are RUNTIME mounts -- they change without rebuilds
VOLUME ["/app/configs", "/app/tasks", "/app/prompts", "/app/data"]
ENV SANDBOX_MODE=docker
ENTRYPOINT ["node", "packages/runner/dist/cli.js"]
CMD ["run", "--root", "/app", "--data", "/app/data"]
