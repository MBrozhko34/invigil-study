[Unit]
Description=Invigil campaign runner (executes currently-eligible probe units)
After=network-online.target docker.service

[Service]
Type=oneshot
User=invigil
WorkingDirectory=/opt/invigil-study
EnvironmentFile=/opt/invigil-study/.env
ExecStart=/usr/bin/node packages/runner/dist/cli.js run --root /opt/invigil-study --data /opt/invigil-study/data
# optional dead-man switch on success:
# ExecStartPost=/usr/bin/curl -fsS https://hc-ping.com/<uuid>
