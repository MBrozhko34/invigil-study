# ===== Runner (laptop) =====
# Per-provider API keys, referenced from configs/providers/*.yaml as env:VAR_NAME
PROVIDER_ALPHA_KEY=
PROVIDER_BETA_KEY=
OPENROUTER_KEY=

# Ed25519 signing key for receipts, 32-byte hex (generate: pnpm --filter @invigil/core keygen)
INVIGIL_SIGNING_KEY=

# ===== Anchoring (laptop, occasional) =====
# Base mainnet or Base Sepolia RPC + deployer key. Keep this wallet tiny; it only posts roots.
ANCHOR_RPC_URL=https://sepolia.base.org
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

# ===== Sandbox =====
# docker | local   (local = subprocess fallback for CI/dev only; production runs use docker)
SANDBOX_MODE=docker
